# Use Aiven's service URI. The backend forces TLS using sslmode=require.
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@pg-668154f-duitflow.k.aivencloud.com:23819/defaultdb?sslmode=require

# Optional: paste Aiven's CA certificate from Connection Information for
# certificate verification. Without it, TLS is encrypted but the CA is not verified.
DB_CA_CERT=

# Optional pool setting
DB_POOL_MAX=5
